{
  "name": "afternote",
  "version": "2.0.0-alpha.6",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:native": "\"$npm_execpath\" run scripts/build-local-sqlcipher-addon.ts",
    "prepare:native-release": "\"$npm_execpath\" run scripts/prepare-native-release-dependencies.ts",
    "package:local": "\"$npm_execpath\" run scripts/build-local-alpha.ts",
    "finalize:release": "\"$npm_execpath\" run scripts/finalize-local-release.ts",
    "release:public": "\"$npm_execpath\" run scripts/build-public-release.ts",
    "typecheck": "tsc --noEmit",
    "test": "\"$npm_execpath\" run build:native && \"$npm_execpath\" test --max-concurrency 1 apps/local packages scripts",
    "test:package": "\"$npm_execpath\" test apps/local/src/package.integration.test.ts",
    "audit": "\"$npm_execpath\" run scripts/audit-lockfile.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "overrides": {
    "sharp": "0.35.3"
  }
}
