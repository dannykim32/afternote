{
  "name": "afternote",
  "version": "2.0.0-beta.6",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "afternote": {
    "bundleVersion": "32"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:native": "\"$npm_execpath\" run scripts/build-local-sqlcipher-addon.ts",
    "prepare:native-release": "/usr/bin/env -u BUN_INSTALL \"$npm_execpath\" run scripts/prepare-native-release-dependencies.ts",
    "package:local": "\"$npm_execpath\" run scripts/build-local-alpha.ts",
    "finalize:release": "\"$npm_execpath\" run scripts/finalize-local-release.ts",
    "release:public": "\"$npm_execpath\" run scripts/build-public-release.ts",
    "typecheck": "\"$npm_execpath\" run node_modules/typescript/bin/tsc --noEmit",
    "test": "\"$npm_execpath\" run build:native && \"$npm_execpath\" test --timeout 15000 --max-concurrency 1 apps/local packages scripts",
    "test:desktop": "AFTERNOTE_TEST_HOST_LAUNCHD=1 \"$npm_execpath\" test apps/local/src/vault-broker-gateway.integration.test.ts --timeout 180000",
    "test:quality": "AFTERNOTE_RELEASE_QUALITY_GATE=1 \"$npm_execpath\" test apps/local/src/recall-eval.test.ts -t \"meets the isolated 10,000-note release performance gate\" --timeout 60000",
    "test:package": "\"$npm_execpath\" test apps/local/src/package.integration.test.ts",
    "audit": "\"$npm_execpath\" run scripts/audit-lockfile.ts",
    "prepare:semantic-release": "\"$npm_execpath\" run scripts/prepare-semantic-release.ts",
    "test:semantic-release": "AFTERNOTE_TEST_MODEL_DIRECTORY=\"$PWD/build/semantic-model\" \"$npm_execpath\" test apps/local/src/compiled-reranked-semantic.test.ts --timeout 120000",
    "test:desktop:semantic": "AFTERNOTE_TEST_MODEL_DIRECTORY=\"$PWD/build/semantic-model\" AFTERNOTE_TEST_HOST_LAUNCHD=1 \"$npm_execpath\" test apps/local/src/vault-broker-gateway.integration.test.ts -t \"owns one authoritative\" --timeout 180000"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/bun": "1.3.14",
    "typescript": "5.9.3"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
